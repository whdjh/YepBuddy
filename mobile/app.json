{
  "expo": {
    "name": "옙버디",
    "slug": "yepbuddy",
    "version": "1.6.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yepbuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.juhun.yepbuddy.app",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleDisplayName": "옙버디",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "완료한 운동 시간을 기기 캘린더에 일정으로 추가합니다.",
        "NSCalendarsFullAccessUsageDescription": "완료한 운동 시간을 기기 캘린더에 일정으로 추가합니다.",
        "NSRemindersUsageDescription": "운동 일정 기능 초기화 시 기기 미리 알림 권한 상태를 확인합니다.",
        "NSRemindersFullAccessUsageDescription": "운동 일정 기능 초기화 시 기기 미리 알림 권한 상태를 확인합니다.",
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.juhun.yepbuddy.app",
      "versionCode": 550010603,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#3F2513",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "backgroundColor": "#3F2513",
            "image": "./assets/images/icon.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "./plugins/with-workout-session",
        {
          "appleTeamId": "U9H4YARLH8"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "운동 중 심박수와 칼로리 데이터를 읽어 세션 결과와 요약 통계에 표시합니다.",
          "healthUpdatePermission": "완료한 운동 세션을 Apple 건강 앱에 운동 기록으로 저장합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "운동 결과에 위치를 표시하고 자주 운동하는 장소를 자동으로 등록합니다.",
          "locationAlwaysPermission": "자동 등록된 운동 장소 주변 진입 후 실제 도착 위치를 확인하고 운동 시작 알림을 보내기 위해 백그라운드 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "운동 결과 위치로 운동 장소를 자동 등록하고, 해당 장소 도착 시 운동 시작 알림을 보내기 위해 위치를 사용합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "완료한 운동 시간을 기기 캘린더에 일정으로 추가합니다.",
          "remindersPermission": "운동 일정 기능 초기화 시 기기 미리 알림 권한 상태를 확인합니다."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6699f81-f2c2-4419-bbd1-e5b54e23ef77",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "WorkoutLiveActivityExtension",
                  "bundleIdentifier": "com.juhun.yepbuddy.app.WorkoutLiveActivityExtension",
                  "parentBundleIdentifier": "com.juhun.yepbuddy.app"
                }
              ]
            }
          }
        }
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
